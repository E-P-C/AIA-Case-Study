# Paths
MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INDEX_DIR=data/index
RAW_DIR=data/raw
LOG_DIR=logs

# Retrieval defaults (spec baseline)
TOP_K=4
SIMILARITY_THRESHOLD=0.45
CONTEXT_GATE_RATIO=0.80
RERANKER_ENABLED=true
TEMPERATURE=0.2
REPEAT_PENALTY=1.3
MAX_NEW_TOKENS=512
N_CTX=4096
N_GPU_LAYERS=0

# Session
SESSION_IDLE_TIMEOUT_SEC=1800

# Auth (demo token)
API_TOKEN=akp-demo-token

# Cost assumptions (USD per 1M tokens) — local GGUF ≈ electricity only;
# we still report "equivalent cloud token cost" for the sensitivity table.
COST_PER_1M_INPUT_TOKENS=0.10
COST_PER_1M_OUTPUT_TOKENS=0.30
